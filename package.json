{
  "name": "claude-code-settings",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:ai": "set -o pipefail && biome lint . --reporter=github 2>&1 | { grep '^::' || true; }",
    "lint:fix": "biome lint --write .",
    "lint:unsafe-fix": "biome lint --write --unsafe .",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "type-check:ai": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.267",
    "@biomejs/biome": "2.3.8",
    "@types/bun": "^1.4.2",
    "ts-morph": "^28.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "cc-hooks-ts": "^2.1.251",
    "defuddle": "^0.19.3",
    "github-reserved-names": "^2.2.0",
    "hono": "^4.13.7",
    "kuromoji": "^0.1.2",
    "linkedom": "^0.18.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "node-htmldiff": "^0.9.4",
    "pathe": "^2.0.3",
    "playwright": "^1.63.0",
    "shiki": "^4.4.3",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ai-words-ja": "^1.2.0",
    "valibot": "^1.5.0"
  }
}
