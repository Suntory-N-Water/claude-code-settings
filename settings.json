{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 999,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
    "CLAUDE_AFK_TIMEOUT_MS": "86400000",
    "DISABLE_COST_WARNINGS": "1",
    "CLAUDE_CODE_DISABLE_CFC_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
    "CLAUDE_CODE_WEBFETCH_CACHE_TTL_MS": "3600000",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_DOCTOR_COMMAND": "1",
    "DISABLE_UPGRADE_COMMAND": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git config --global credential.*)",
      "Bash(gh auth setup-git)",
      "Bash(rm -rf)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "artifact-design": "off",
    "claude-api": "off",
    "deep-research": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "verify": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "claude-in-chrome": "off",
    "update-config": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/session-start-reminder.ts"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/opus5-rule-inject.ts"
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/cache-ttl-guard.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/cache-ttl-guard.ts"
          },
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/inject-comments.ts"
          },
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/negation-guard.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/create-plan-link.ts"
          },
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/md-to-html.ts"
          },
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/style-check.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/md-to-html.ts"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/plan-mode-style.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/textlint-pre-tool-use.ts"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/notify-input-needed.ts"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/web-fetch-advice.ts"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/notify-input-needed.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/notify-turn-end.ts",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/style-check-stop.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/conversation-style-check.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/mikke-embed.ts",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/cache-ttl-guard.ts"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Explore|general-purpose",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/subagent-research-context.ts"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "Explore|general-purpose",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/subagent-archive.ts"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/tool-failure-log.ts"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.py"
  },
  "outputStyle": "Concise",
  "language": "日本語",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "emojiCompletionEnabled": false,
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "timeZone": "Asia/Tokyo",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "showTurnDuration": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "environment": [
      "$defaults"
    ]
  },
  "leftArrowOpensAgents": false
}
